{
  "name": "museauto-studio",
  "productName": "MuseAuto Studio (clean-room)",
  "version": "0.1.0",
  "description": "From-scratch desktop tool for faceless-video production: storyboard, batch ffmpeg video assembly, offline Whisper subtitles.",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "author": "cuong.nm1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "ffmpeg-static": "^5.2.0",
    "msedge-tts": "^2.1.1",
    "playwright-core": "^1.49.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cuong.museauto.studio",
    "productName": "MuseAuto Studio",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
